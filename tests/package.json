{
  "name": "qlekha-tests",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --reporter=verbose",
    "test:unit": "vitest run unit/ --reporter=verbose",
    "test:integration": "vitest run integration/ --reporter=verbose",
    "test:ui": "vitest run ui/ --reporter=verbose",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest": "echo '🧪 Running QLekha tests...'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "dotenv": "^16.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.6.0",
    "jsdom": "^24.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.0"
  }
}
